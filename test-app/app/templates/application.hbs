<div class="container">
    <main class="main">
        <h1>Ember Class Toggle Modifier - Test App</h1>
        <form class="form" action="javascript:void(0)">
            <div class="form__row">
                <div class="form__label">Accordion</div>
                <Accordion />
            </div>
            <div class="form__row">
                <div class="form__label">Selectbox</div>
                <div class="form__cols">
                    <div class="form__col form__col--half">
                        <Selectbox
                          @name="numbers"
                          @options={{array (hash value=1 label='One') (hash value=2 label='Two') (hash value=3 label='Three')}}
                          @default={{ 2 }}
                        />
                    </div>
                    <div class="form__col form__col--half">
                        <Selectbox
                          @name="names"
                          @options={{array (hash value=1 label='John') (hash value=2 label='Peter') (hash value=3 label='Mike')}}
                        />
                    </div>
                </div>
            </div>
            <div class="form__row">
                <div class="form__label">Multi Selectbox</div>
                <div class="form__cols">
                   <div class="form__col form__col--half">
                        <MultiSelectbox
                          @name="animals"
                          @options={{array 'Dog' 'Cat' 'Cobra' 'Cow' 'Horse' 'Koala' 'Pigeon' 'Rabbit' 'Tiger' 'Turtle' 'Wolf'}}
                          @default={{array 'Cow' 'Koala' 'Rabbit'}}
                        />
                    </div>
                    <div class="form__col form__col--half">
                        <MultiSelectbox
                          @name="food"
                          @options={{array 'Bread' 'Burger' 'Pasta' 'Pizza' 'Potatoes'}}
                        />
                    </div>
                </div>
            </div>
            <div class="form__row">
                <div class="form__label"><span>Searchbox</span><span class="form__help"><Popup @label="i" @header="Search Help" @content="Click on the magnifier button to start the search." /></span></div>
                <Searchbox @name="term" />
            </div>
            <div class="form__row">
                <div class="form__label"><span>Colors</span><span class="form__help"><Popup @label="i" class="form__help" @header="Color Help" @content="Pick a color." /></span></div>
                <Colors @name="colors" />
            </div>
            <div class="form__row">
                <div class="form__label">Mood</div>
                <Mood @name="mood" />
            </div>
        </form>
    </main>
</div>
<div id="popups"></div>
